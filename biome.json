{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useNodejsImportProtocol": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off",
				"noEmptyInterface": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": [
			"scripts/check-architecture-boundaries.mjs",
			"scripts/check-runtime-cycles.mjs",
			"scripts/check-public-api.mjs",
			"scripts/check-duplicates.mjs",
			"scripts/check-unused-deps.mjs",
			"scripts/check-dead-exports.mjs",
			"scripts/lib/source-program.mjs",
			"scripts/check-ts-relative-imports.mjs",
			"scripts/test/**/*.mjs",
			"packages/agent/vitest*.config.ts",
			"scripts/bench-prompt-cache.ts",
			"scripts/fixtures/prompt-cache-baseline.ts",
			"scripts/lib/prompt-cache-quality.ts",
			"packages/ai/test-support/prompt-cache-wire.ts",
			"packages/*/src/**/*.ts",
			"packages/*/src/**/*.tsx",
			"packages/*/test/**/*.ts",
			"packages/*/test/**/*.tsx",
			"packages/*/e2e/**/*.tsx",
			"packages/coding-agent/examples/**/*.ts",
			"!**/node_modules/**/*",
			"!**/test-sessions.ts",
			"!**/models.generated.ts",
			"!**/*.models.ts",
			"!packages/mom/data/**/*",
			"!!**/node_modules"
		]
	}
}
