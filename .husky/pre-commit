#!/bin/sh
# Staged-file gate. The full repository gate runs in the pre-push hook and CI.
STAGED_FILES=$(git diff --cached --name-only)

node scripts/check-lockfile-commit.mjs || exit 1

echo "Running the staged pre-commit gate (npm run check:fast)..."
npm run check:fast || exit 1

# Restage files that were previously staged and may have been modified by formatting
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    # The path was already staged, so force only allows tracked files that are
    # now covered by an ignore rule to be restaged after formatting.
    git add -f -- "$file"
  fi
done

echo "✅ Pre-commit checks passed! Run the full gate (npm run check) or push to run it in pre-push."
