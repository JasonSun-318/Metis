{
	"name": "@metis/desktop",
	"version": "0.0.8",
	"description": "Secure Electron desktop shell for Metis",
	"private": true,
	"main": ".webpack/main",
	"scripts": {
		"clean": "shx rm -rf .webpack out",
		"start": "electron-forge start",
		"package": "node scripts/package.mjs package",
		"make": "node scripts/package.mjs make",
		"publish:update": "node scripts/publish-update.mjs",
		"verify:package": "node scripts/verify-package.mjs",
		"check:types": "tsgo --noEmit -p tsconfig.main.json && tsgo --noEmit -p tsconfig.renderer.json && tsgo --noEmit -p tsconfig.test.json",
		"test": "vitest --run",
		"test:e2e": "playwright test",
		"profile": "node ../../scripts/profile-desktop.mjs"
	},
	"dependencies": {
		"@aiden0z/pptx-renderer": "1.2.4",
		"@codemirror/lang-css": "6.3.1",
		"@codemirror/lang-html": "6.4.12",
		"@codemirror/lang-javascript": "6.2.5",
		"@codemirror/lang-json": "6.0.2",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/lang-python": "6.2.1",
		"@codemirror/lang-yaml": "6.1.3",
		"@codemirror/language": "6.12.4",
		"@lezer/highlight": "1.2.3",
		"@metis/app-protocol": "^0.0.8",
		"@metis/app-server": "^0.0.8",
		"@phosphor-icons/react": "2.1.10",
		"@pierre/diffs": "1.3.0-beta.7",
		"@tanstack/react-virtual": "3.14.6",
		"@xterm/addon-fit": "0.10.0",
		"@xterm/xterm": "5.5.0",
		"codemirror": "6.0.2",
		"d3-force": "3.0.0",
		"docx-preview": "0.4.0",
		"electron-squirrel-startup": "1.0.1",
		"i18next": "26.3.6",
		"jszip": "3.10.1",
		"marked": "18.0.5",
		"material-icon-theme": "5.37.0",
		"node-pty": "1.1.0",
		"pdfjs-dist": "4.10.38",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-i18next": "17.0.11",
		"xlsx": "0.18.5"
	},
	"devDependencies": {
		"@electron-forge/cli": "7.11.2",
		"@electron-forge/maker-deb": "7.11.2",
		"@electron-forge/maker-dmg": "7.11.2",
		"@electron-forge/maker-rpm": "7.11.2",
		"@electron-forge/maker-squirrel": "7.11.2",
		"@electron-forge/maker-zip": "7.11.2",
		"@electron-forge/plugin-auto-unpack-natives": "7.11.2",
		"@electron-forge/plugin-base": "7.11.2",
		"@electron-forge/plugin-webpack": "7.11.2",
		"@electron-forge/shared-types": "7.11.2",
		"@electron/asar": "3.4.1",
		"@electron/fuses": "2.1.3",
		"@playwright/test": "1.61.1",
		"@types/d3-force": "3.0.10",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"copy-webpack-plugin": "12.0.2",
		"css-loader": "7.1.4",
		"electron": "43.1.1",
		"jsdom": "29.1.1",
		"mini-css-extract-plugin": "2.10.2",
		"shx": "0.4.0",
		"ts-loader": "9.6.2",
		"vitest": "4.1.9",
		"webpack": "5.108.4",
		"webpack-cli": "7.2.1"
	}
}
