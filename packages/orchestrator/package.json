{
	"name": "@arcmind/orchestrator",
	"version": "0.80.6",
	"description": "experimental orchestrator package for arcmind",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"arcmind",
		"orchestrator"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://gitee.com/sun124578963_0/arc-mind.git",
		"directory": "packages/orchestrator"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@arcmind/coding-agent": "^0.80.6"
	},
	"devDependencies": {
		"shx": "0.4.0"
	}
}
