{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@metis/ai": ["./packages/ai/src/index.ts"],
			"@metis/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@metis/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@metis/ai/dist/*": ["./packages/ai/src/*"],
			"@metis/agent-core": ["./packages/agent/src/index.ts"],
			"@metis/agent-core/*": ["./packages/agent/src/*"],
			"@metis/app-protocol": ["./packages/app-protocol/src/index.ts"],
			"@metis/app-protocol/*": ["./packages/app-protocol/src/*"],
			"@metis/app-server": ["./packages/app-server/src/index.ts"],
			"@metis/app-server/*": ["./packages/app-server/src/*"],
			"@metis/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@metis/coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@metis/coding-agent/*": ["./packages/coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@metis/tui": ["./packages/tui/src/index.ts"],
			"@metis/tui/*": ["./packages/tui/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/desktop/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
